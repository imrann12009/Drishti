{
  "editor.formatOnSave": true,
  "editor.rulers": [80],
  "files.exclude": {
    "**/.dart_tool": true,
    "**/.idea": true,
    "**/build": true,
    "**/.DS_Store": true
  },
  "dart.lineLength": 80,
  "dart.previewFlutterUiGuides": true,
  "dart.previewFlutterUiGuidesCustomTracking": true,
  "[dart]": {
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit"
    }
  }
}
