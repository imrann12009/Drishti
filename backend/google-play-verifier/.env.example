PORT=8787
# Final Android applicationId from the generated Android project.
GOOGLE_PLAY_PACKAGE_NAME=com.example.drishti
# Keep the JSON outside the repository or use a secret manager.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-play-service-account.json
# Long random secret used by the Flutter app to authenticate backend requests.
DRISHTI_VERIFY_SHARED_SECRET=replace-me
# Optional Pub/Sub push authentication secret or gateway validation strategy.
RTDN_SHARED_SECRET=replace-me-too
# AI chat: keep this key only on the server or a managed secret store.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Optional HTTPS-compatible provider endpoint; default is OpenAI's API.
OPENAI_BASE_URL=https://api.openai.com/v1
# Production: validate a real server-issued user session/JWT at /v1/chat.
# This scaffold accepts a temporary bearer value only at the server boundary.
DRISHTI_CHAT_SESSION_SECRET=replace-with-session-validation-secret
# Development only; never set to true in production.
DRISHTI_ALLOW_UNAUTHENTICATED_CHAT=false
