# Server-only Groq configuration. Never put real values in source control.
GROQ_API_KEY=replace_with_your_server_side_key
# Current Groq production model; change only to a model supported by your account.
GROQ_MODEL=llama-3.3-70b-versatile
PORT=8788
HOST=127.0.0.1
# Optional, comma-separated origins for Flutter web development; do not use *.
CORS_ORIGINS=http://127.0.0.1:51080
# Development only. Production must be HTTPS behind authenticated infrastructure.
NODE_ENV=development
